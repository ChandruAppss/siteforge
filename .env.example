# Copy this file to .env and fill in your key.
#   cp .env.example .env

# Required — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional
PORT=3000

# Model used to generate the websites.
#   claude-sonnet-5  — fast + cheap, good quality (default)
#   claude-opus-5    — best quality, slower and pricier
ANTHROPIC_MODEL=claude-sonnet-5

# How many websites to generate per request (1-6).
VARIANT_COUNT=6

# Copy this file to .env and fill in your key.
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000

# Model used to generate the websites.
#   claude-sonnet-5  — fast + cheap, good quality (default)
#   claude-opus-5    — best quality, slower and pricier
ANTHROPIC_MODEL=claude-sonnet-5

# Output ceiling per generated website.
MAX_TOKENS=12000

# How many websites to generate per submission (1-6).
VARIANT_COUNT=6

# ── Abuse protection ────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED once deployed. /api/generate is public and every call
# spends real API credit.
#
# ACCESS_CODE: if set, the generator will not run without it. The field appears
# on the form automatically. Leave unset for a fully open generator.
# ACCESS_CODE=pick-something-long

# Per-IP rate limit. NOTE: this is best-effort only — on serverless it is
# enforced per instance, not globally, so the real ceiling is roughly
# (RATE_MAX x number of live instances). ACCESS_CODE is the actual protection.
RATE_MAX=12
RATE_WINDOW_MS=3600000

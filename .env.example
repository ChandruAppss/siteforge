# Copy this file to .env and fill in ONE provider key.
#   cp .env.example .env

# ── Pick a provider ─────────────────────────────────────────────────────────
# Set exactly one of these API keys. If you set several, the first free-tier
# one wins unless you name a provider explicitly with AI_PROVIDER below.
#
#   [free tier]  GEMINI_API_KEY       https://aistudio.google.com/apikey
#   [free tier]  GROQ_API_KEY         https://console.groq.com/keys
#   [free tier]  OPENROUTER_API_KEY   https://openrouter.ai/keys
#   [paid]       ANTHROPIC_API_KEY    https://console.anthropic.com/settings/keys
#   [paid]       OPENAI_API_KEY       https://platform.openai.com/api-keys
#
# Free tiers have rate limits and can change without notice — check the
# provider's current terms before relying on one in production.

GEMINI_API_KEY=

# ── Optional: pin the provider and model ────────────────────────────────────
# AI_PROVIDER forces a specific provider instead of auto-detecting.
#   gemini | groq | openrouter | anthropic | openai
# AI_PROVIDER=gemini

# AI_MODEL overrides the provider's default model. Model ids change often —
# if you get a "model not found" error, set this to a current one.
#   gemini      gemini-2.0-flash
#   groq        llama-3.3-70b-versatile
#   openrouter  meta-llama/llama-3.3-70b-instruct
#   anthropic   claude-sonnet-5  /  claude-haiku-4-5-20251001
#   openai      gpt-4o-mini
# AI_MODEL=

# ── General ─────────────────────────────────────────────────────────────────
PORT=3000

# Output ceiling per generated website. This is the main lever on both speed
# and cost — latency tracks output length almost linearly.
MAX_TOKENS=8000

# How many websites to generate per submission (1-6). Lower it to cut cost.
VARIANT_COUNT=6

# ── Local development ───────────────────────────────────────────────────────
# MOCK_GENERATION=1 streams a canned page instead of calling a real provider,
# so the streaming UI can be exercised without a key and without cost.
# MOCK_GENERATION=1
# MOCK_DELAY_MS=700
# MOCK_FAIL=1     # simulate a failure to test the error path

# ── Abuse protection ────────────────────────────────────────────────────────
# STRONGLY RECOMMENDED once deployed. /api/generate is public and every call
# spends real quota or credit.
#
# ACCESS_CODE: if set, the generator will not run without it. The field appears
# on the form automatically. Leave unset for a fully open generator.
# ACCESS_CODE=pick-something-long

# Per-IP rate limit. NOTE: this is best-effort only — on serverless it is
# enforced per instance, not globally, so the real ceiling is roughly
# (RATE_MAX x number of live instances). ACCESS_CODE is the actual protection.
RATE_MAX=12
RATE_WINDOW_MS=3600000
